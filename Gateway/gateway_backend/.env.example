# Database: shared Neon Postgres (same DB as the strategies — table names don't overlap).
# Use the *pooler* host. Local SQLite fallback: sqlite:///./gateway.db
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# CORS - comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

# Encryption key for credentials at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Secret used to sign app user JWTs (signup/signin). Keep private.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Shoonya egress proxy (IP-bound auth + order fallback) -----------------
# Shoonya only accepts API calls from a registered static IP. If this host's IP
# is refused, IP-bound calls (auth + orders) fall back through a proxy that sits
# on a whitelisted IP. Empty = feature off (calls go direct only).
# List several comma-separated to fail over if a proxy box dies; tried in order:
#   SHOONYA_PROXY=http://user:pass@host1:port,http://user:pass@host2:port
SHOONYA_PROXY=
# off | auto | on  — auto: direct first, proxy only after an IP rejection.
SHOONYA_PROXY_MODE=auto
# auth | auth+orders | all  — which call kinds may use the proxy.
SHOONYA_PROXY_SCOPE=auth+orders
