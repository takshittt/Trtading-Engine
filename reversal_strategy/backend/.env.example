# SWING_BROKER_MODE:   "shoonya" (LIVE, via the shared Gateway) | "mock" (offline sim)
SWING_BROKER_MODE=shoonya
# SWING_SIGNAL_SOURCE: "mock" (fake feed, dev only) | "none" (signals added manually)
SWING_SIGNAL_SOURCE=none
# Dev only: treat the market as always open so the pipeline runs 24/7. NEVER in prod.
SWING_IGNORE_MARKET_HOURS=false

# CORS origins for the dashboard
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database ----
# Shared Neon Postgres (same DB as the Gateway). Unset SWING_DB_URL to fall back
# to a local SQLite file at SWING_DB_PATH.
# SWING_DB_PATH=/absolute/path/reversal_strategy.db
SWING_DB_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---- Shared Gateway (broker REST/WS) ----
SWING_GATEWAY_BASE_URL=http://localhost:8000
SWING_GATEWAY_WS_URL=ws://localhost:8000/api/ws/ticker

# Service identity — authorizes broker calls (from register_service on the Gateway).
SWING_GATEWAY_CLIENT_ID=
SWING_GATEWAY_CLIENT_SECRET=
# Legacy pre-JWT gateway header; unused with the shared Gateway.
# SWING_GATEWAY_SECRET=

# Shard identity — authorizes the backend to talk to the Gateway. 
JWT_SECRET=

# ---- Margin / data (optional overrides) ----
# Authoritative daily F&O margin comes from Shoonya's SPAN calculator via the
# Gateway. Set true to also parse raw NSE SPAN files (implement _from_nse_span_file):
SWING_ENABLE_NSE_SPAN=false
# SWING_SCRIPMASTER_URL=https://api.shoonya.com/{exch}_symbols.txt.zip
