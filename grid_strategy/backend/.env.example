# Grid engine configuration (copy to .env or export in your shell)

# Where the Shoonya gateway runs
GATEWAY_BASE_URL=http://localhost:8000
GATEWAY_WS_URL=ws://localhost:8000/api/ws/ticker

# Service identity for calling the Gateway. Create with (from gateway_backend/):
#   python -m scripts.register_service --name grid
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=

# MUST be identical to the Gateway's JWT_SECRET — used to verify the human user
# token presented to grid's own dashboard (local HS256 verification).
JWT_SECRET=

# Database: shared Neon Postgres (same DB as the Gateway). Local SQLite
# fallback: sqlite:///./grid.db
GRID_DB_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Global circuit breaker across ALL instruments, ₹ loss (0 = disabled)
GLOBAL_CB_THRESHOLD=0

# CORS origins for the dashboard
ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5173,http://localhost:4173
